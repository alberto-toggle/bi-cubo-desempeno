{"title": "Analytics 3", "description": "A comparison widget displaying revenue distribution between paid acquisition and organic search channels with a dual progress bar.", "name": "app-analytics-3", "dependencies": [], "registryDependencies": ["card", "button", "dropdown-menu"], "type": "registry:block", "files": [{"path": "components/blocks/app/analytics/analytics-3.tsx", "type": "registry:block", "content": "import { Globe, MoreVertical, Target } from \"lucide-react\";\n\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardAction, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport {\n    DropdownMenu,\n    DropdownMenuContent,\n    DropdownMenuItem,\n    DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\n\nexport const Analytics3 = () => {\n    const ranges = [\"This Month\", \"Last Month\", \"This Quarter\"];\n\n    const metric = {\n        title: \"Revenue Overview\",\n        value: \"54.8k\",\n        trend: \"+14.6%\",\n        segments: [\n            {\n                name: \"Paid Acquisition\",\n                percentage: \"58.2%\",\n                count: \"$31,893\",\n            },\n            {\n                name: \"Organic Search\",\n                percentage: \"41.8%\",\n                count: \"$22,907\",\n            },\n        ],\n    };\n\n    return (\n        <Card className=\"gap-4\">\n            <CardHeader>\n                <div>\n                    <CardTitle>{metric.title}</CardTitle>\n                    <div className=\"mt-1.5 flex items-center gap-2.5\">\n                        <span className=\"text-3xl font-semibold\">\n                            <span className=\"text-muted-foreground me-0.5 align-super text-xl font-medium\">$</span>\n                            {metric.value}\n                        </span>\n                        <span className=\"text-sm font-medium text-green-500\">{metric.trend}</span>\n                    </div>\n                </div>\n                <CardAction>\n                    <DropdownMenu>\n                        <DropdownMenuTrigger\n                            render={\n                                <Button variant=\"ghost\" size=\"icon-xs\" className=\"cursor-pointer\">\n                                    <MoreVertical className=\"size-4\" />\n                                </Button>\n                            }></DropdownMenuTrigger>\n                        <DropdownMenuContent align=\"end\" className=\"w-40\">\n                            {ranges.map((item) => (\n                                <DropdownMenuItem key={item} className=\"cursor-pointer text-sm\">\n                                    {item}\n                                </DropdownMenuItem>\n                            ))}\n                        </DropdownMenuContent>\n                    </DropdownMenu>\n                </CardAction>\n            </CardHeader>\n            <CardContent className=\"grid gap-6\">\n                <div className=\"grid items-center gap-4 sm:grid-cols-[1fr_auto_1fr]\">\n                    <div className=\"grid gap-3\">\n                        <div className=\"flex items-center gap-2\">\n                            <div className=\"bg-muted flex size-8 shrink-0 items-center justify-center rounded-md\">\n                                <Target className=\"size-4\" />\n                            </div>\n                            <span className=\"truncate text-sm font-medium\">{metric.segments[0].name}</span>\n                        </div>\n                        <div className=\"grid gap-0.5\">\n                            <span className=\"text-2xl font-medium\">{metric.segments[0].percentage}</span>\n                            <span className=\"text-muted-foreground text-sm\">{metric.segments[0].count}</span>\n                        </div>\n                    </div>\n\n                    <div className=\"relative flex h-full items-center justify-center sm:flex-col\">\n                        <div className=\"bg-border max-sm:h-px max-sm:w-full sm:h-full sm:w-px\" />\n                        <div className=\"bg-card text-muted-foreground absolute top-1/2 flex size-7 -translate-y-1/2 items-center justify-center rounded-md border text-xs font-medium\">\n                            VS\n                        </div>\n                    </div>\n\n                    <div className=\"grid justify-items-end gap-3 text-end\">\n                        <div className=\"flex flex-row-reverse items-center gap-2\">\n                            <div className=\"bg-muted flex size-8 shrink-0 items-center justify-center rounded-md\">\n                                <Globe className=\"size-4\" />\n                            </div>\n                            <span className=\"truncate text-sm font-medium\">{metric.segments[1].name}</span>\n                        </div>\n                        <div className=\"grid gap-0.5\">\n                            <span className=\"text-2xl font-medium\">{metric.segments[1].percentage}</span>\n                            <span className=\"text-muted-foreground text-sm\">{metric.segments[1].count}</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"bg-muted flex h-2 w-full overflow-hidden rounded-md\">\n                    <div\n                        className=\"h-full transition-all\"\n                        style={{ width: \"58.2%\", backgroundColor: \"var(--chart-1)\" }}\n                    />\n                    <div\n                        className=\"h-full transition-all\"\n                        style={{ width: \"41.8%\", backgroundColor: \"var(--chart-2)\" }}\n                    />\n                </div>\n            </CardContent>\n        </Card>\n    );\n};\n"}], "mcp": {"description": "A comparison widget displaying revenue distribution between paid acquisition and organic search channels with a dual progress bar. Relies on card, button, dropdown-menu. Ideal when an AI agent needs to compose section layouts or application views.", "tags": ["block", "application", "analytics"]}}